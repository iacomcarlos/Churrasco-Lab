# Endereço final do site (já vem com o domínio oficial como padrão em src/config/evento.ts)
NEXT_PUBLIC_SITE_URL=

# Inscrições (banco Supabase). Sem estes dois valores, o formulário não aparece no site publicado.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=

# Opcional: analytics. Deixe vazio para não carregar nenhum script de terceiros.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=
